{"uuid":"08f36e02-7cdd-452e-bc9d-96a732eaa388","name":"giant-vault","title":"Amber Valley","dataSource":{"uuid":"8bbbf551-fddb-44bf-91af-8db01c475861","title":"Amber Valley","path":"/app/working/references/41192e19-c6f5-4e72-afdc-1428ac2cf4b4.XLSX","mime":"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet","columns":[{"uuid":"1bb2c11d-583e-4474-8e2c-f29b3f972468","name":"Property address"},{"uuid":"8ae52698-8069-4802-bc12-2d2402443afe","name":"Liablefrom"},{"uuid":"6928fc05-16e0-4a9e-8da7-d96d6ee15d3f","name":"Emptyfrom"},{"uuid":"5ccf4f22-dee9-4b9b-8455-b5ac84996879","name":"Description"},{"uuid":"42733594-16d0-4e50-a571-cf7865b0da51","name":"Account holder address"},{"uuid":"bf1bca8e-aaa4-404f-9d78-beafdcf12593","name":"Charge amount"},{"uuid":"985eb97f-8d84-4076-b8f1-3a5fc8b0c4ab","name":"Rateable value"},{"uuid":"94b04048-0ead-427f-abda-bf48915bd6fa","name":"Reference"},{"uuid":"a314bf10-3a92-4ec2-afa6-c4a83ab75dc5","name":"Relief type"},{"uuid":"8197b51a-3fa4-4646-9061-6634ce33e7ef","name":"Relief value"},{"uuid":"384bd9fc-1e28-444b-91dd-ca77652be556","name":"Exemption type"},{"uuid":"dfa1bd0a-dde9-4d30-b3cc-e4db471eb1bb","name":"Exemption date"}],"preserve":["Property address","Liablefrom","Emptyfrom","Description","Account holder address","Charge amount","Rateable value","Reference","Relief type","Relief value","Exemption type","Exemption date"],"attributes":{},"checksum":"16561860ff0adef956d6c1cd28a73b245e0ae2ae262e3364895cc081ca2e1dc26acf61202a0397c2c6ad184a648e20754fb7048a0bed8b2b74df68c0e0de6d72","index":7372},"crosswalk":{"uuid":"57da6e7a-fb27-47b1-b41b-e2974cb90aca","name":"e07000032","title":"Amber Valley","schemaSource":{"uuid":"fa7df855-26ea-43b4-b535-5b4c47fc2291","name":"e07000032","title":"Amber Valley","fields":[{"uuid":"c0226c5e-3ccf-4f70-a324-dc4025c9f797","name":"Property address","title":"Property address","type":"string"},{"uuid":"a81bc2e7-4622-44d5-ab14-69ea222f3848","name":"Liablefrom","title":"Liablefrom","type":"string"},{"uuid":"054705b1-4d14-46b7-a14f-3c523cf9b4ba","name":"Emptyfrom","title":"Emptyfrom","type":"date","constraints":{"enum":[{"uuid":"b0ca9d40-fb22-4fec-8c43-3466c21afd16","name":true},{"uuid":"820346fb-4e9f-40d0-98b9-1f398f8294fb","name":false}]}},{"uuid":"240f411b-9bc9-4ef4-be55-c31939ad29d1","name":"Description","title":"Description","type":"string"},{"uuid":"9424495f-6e6c-4d5c-bb12-13e7af8e86aa","name":"Account holder address","title":"Account holder address","type":"string"},{"uuid":"8cff02db-326e-4542-b6ff-be4413842c5b","name":"Charge amount","title":"Charge amount","type":"string"},{"uuid":"45225b19-1563-4d8f-8d08-99c49db4d9c6","name":"Rateable value","title":"Rateable value","type":"string"},{"uuid":"8814e1d8-7aee-4917-9a63-5f1f45c107a0","name":"Reference","title":"Reference","type":"string"},{"uuid":"4653f456-f8f6-4746-b8b3-1ebb98d9b147","name":"Relief type","title":"Relief type","type":"string","constraints":{"enum":[{"uuid":"427c3384-e43b-42ad-a35e-f36f6697d195","name":"Trans Prem"},{"uuid":"bc0dc340-3c19-403b-a78b-42a9e5e72555","name":"Mandatory"},{"uuid":"1f43ec11-d4a3-4e5f-8c3a-9cfed68b1d73","name":"Discretionary"},{"uuid":"801e4543-f9b8-4aa7-a21b-e7a9f8bd6ee2","name":"SBRR"},{"uuid":"8a839dd5-baaf-4bfd-99ed-96da28d3d24e","name":"Transitional"}]}},{"uuid":"7e67bbe7-cacb-454f-91e5-3456667b6c34","name":"Relief value","title":"Relief value","type":"string"},{"uuid":"0a444276-0ddb-43e6-a236-7edc48a5cdc6","name":"Exemption type","title":"Exemption type","type":"string","constraints":{"enum":[{"uuid":"3956f29c-dce0-459a-824b-a942c0ae43a4","name":"Listed Buildings"},{"uuid":"86ee4eb7-3fef-4394-952e-e48c941e88c4","name":"Land"},{"uuid":"567563d0-a297-44a2-ad50-b7e85cf3147e","name":"Telecommunication Masts"},{"uuid":"3c7e8492-db7f-4627-8c2f-9c3c30c154a4","name":"Charities"},{"uuid":"5d757eb8-b783-4483-a0ab-4fd609bbaa18","name":"CASCs"}]}},{"uuid":"e7b74af6-dded-47a4-ab93-5db4cb6c256a","name":"Exemption date","title":"Exemption date","type":"string"}],"index":4819,"version":[{"name":"redgine04@gmail.com","description":"Initial save of SchemaModel.","updated":"2024-06-20T12:26:17.901487"},{"name":"redgine04@gmail.com","description":"Update save of SchemaModel.","updated":"2024-06-21T03:07:17.143448"},{"name":"redgine04@gmail.com","description":"Update save of SchemaModel.","updated":"2024-06-21T03:07:18.412815"},{"name":"redgine04@gmail.com","description":"Update save of SchemaModel.","updated":"2024-06-21T03:08:08.053517"},{"name":"Gavin Chait <gchait@whythawk.com>","description":"Update save of SchemaModel.","updated":"2025-07-26T15:30:11.762303"},{"name":"redgine04@gmail.com","description":"Update save of SchemaModel.","updated":"2026-05-20T10:44:22.621099"},{"name":"redgine04@gmail.com","description":"Update save of SchemaModel.","updated":"2026-05-20T10:44:24.092977"},{"name":"redgine04@gmail.com","description":"Update save of SchemaModel.","updated":"2026-05-20T10:45:25.991498"}]},"schemaDestination":{"uuid":"507a0ccf-5735-4b3a-9b9e-2e7842921e4a","name":"england-and-wales-nondomestic-rates-schema","title":"England and Wales non-domestic rates schema","description":"Based on the The Open Data Collaboration group at Open Innovations (Open Innovations, Bradford Council, Calderdale Council, and Leeds Council) which started a project to visualise business rates data. Although each of the three councils publish open data about their business rates, they each have different field titles and don't always include the same fields. This project aimed to standardise the way the data was shared to make it more usable and to get value (within a council and externally) from the datasets.\nhttps://open-innovations.org/projects/business-rates/format.html","fields":[{"uuid":"e1b1d480-8481-4281-98bd-0e59f7fdb949","name":"localAuthorityCode","title":"Local authority code","description":"Unique reference identifier for each local authority. Added from the Task 'name' unique identifier field.","type":"string","constraints":{"default":{"uuid":"a989d748-ff9a-4585-be82-d1876032f6a2","name":"E07000032"}}},{"uuid":"f42d609b-c8a6-4017-aa9d-d55eb62bd63b","name":"localBillingReference","title":"Billing reference","description":"Local Authority hereditament billing reference used by both VOA & LA to correspond with each other in reference to a specific hereditament.","type":"string","example":"8577090904","constraints":{"required":true,"enum":[]}},{"uuid":"7774382b-7054-4100-8bf1-ff9741a47d5a","name":"occupierAccountHolderName","title":"Occupier account-holder name","description":"Account-holder's names may be split across multiple columns. They are to be joined into one for post-processing.","type":"string","example":"A.M.C (North East) Ltd"},{"uuid":"02347dbe-d491-47cb-bfd4-2a3c28c4c861","name":"occupierRecordDate","title":"Date each row entered the record","type":"date"},{"uuid":"090b1d3d-3be0-4d39-b24b-8c97969eeb8f","name":"occupierAccountStartDate","title":"Start-date for account-holder","description":"Date the Account Holder became responsible for the hereditament. Provide date only if provided in data release from LA. e.g. \"01/01/23\", \"BLANK\" or \"Not Supplied\".","type":"date"},{"uuid":"cb30a0df-ea14-4c67-b76a-1ab358f167bd","name":"occupierPropertyAddress","title":"Address of the rateable property","description":"Address may be split across multiple columns. They are to be joined into one for post-processing with the postcode at the end.","type":"string"},{"uuid":"3ed85652-0831-4cd3-a005-a353b6cc51a1","name":"occupierCorrespondenceAddress","title":"Correspondence address","description":"Account-holders correspondence address may be split across multiple columns. They are to be joined into one for post-processing with the postcode at the end. This may be different from the hereditament address.","type":"string"},{"uuid":"6305545d-7caf-40fb-b421-2e483c3fbd96","name":"occupierOccupationState","title":"Occupation state","description":"Occupational status of hereditament. Only include if provided in LA data release.\nOccupied = \"Occupied\", Void = \"Void\", No Information = \"BLANK\", no empty data provided by LA = \"Not Supplied\"","type":"string","constraints":{"enum":[{"uuid":"83cd608f-ae55-4090-836d-154c2ec256d7","name":"Occupied","description":"Occupied"},{"uuid":"de15f74d-90c3-4f38-8821-37e3178787bd","name":"Vacant","description":"Vacant"}]}},{"uuid":"17c261f9-e837-49d1-abe1-fc63f2a80f86","name":"occupierOccupationDate","title":"Occupation state date","description":"To be used in combination with 'occupierOccupationState'. If only a date is provided (e.g. for only date of void, or date of occupation), then categorise the column as a boolean and use this to specify the state and the date simultaneously.","type":"date"},{"uuid":"e325315f-5ec0-416d-a470-4facfb7bb759","name":"occupierRatesPayable","title":"Actual rates paid","description":"Rates paid, net of reliefs (if available) in pounds. Provide rates paid amount only if provided in data release from LA. e.g. \"£55,000\", \"BLANK\", \"not supplied\".","type":"number"},{"uuid":"1dba84d1-501a-427f-88ad-771e2393516a","name":"occupierReliefType","title":"Relief or Exemption Received","description":"Type of relief or exemption on rates paid received.\n\nNOTE: Type, Date and Amount are arrays and the position in the array must correspond between these three columns. This is for both 'wide' data (where there are multiple columns in the source data for each class of relief) and 'narrow' data (where there is only one set of columns). Narrow data must still be placed in an array (e.g. ['value'], with only one value).","type":"array","constraints":{"enum":[{"uuid":"60fd0916-8f55-4236-8a26-e09cbc9b3c25","name":"charity"},{"uuid":"4f6de275-e6af-4da5-adee-6e5ec60d0488","name":"covid_carf"},{"uuid":"dde9af58-e13c-4ca0-be93-4d46fadb760f","name":"discretionary"},{"uuid":"1b66abb2-3de7-4cfa-8a21-94be7abf8d0a","name":"empty"},{"uuid":"9ec6a8bd-2ee1-4061-bd1d-d454b57c167d","name":"enteprise_zone"},{"uuid":"4320d78d-4d6f-4c31-ba94-0ad2f20bc185","name":"exempt"},{"uuid":"e1895f58-8bc1-4c4c-9f4b-f9f4a507ce5d","name":"hardship"},{"uuid":"3887112a-d266-4e8d-9aa6-1771f2273c9c","name":"insolvency"},{"uuid":"82fe4da5-1e7c-4406-a076-3d8557d64b1b","name":"listed"},{"uuid":"53baf5cb-aff8-47e6-b9ab-f517365f5f7f","name":"mandatory"},{"uuid":"a8a4c3d6-ca77-4776-a754-5848a8415bf3","name":"retail","description":"Has differing definitions at different times"},{"uuid":"f50ade3e-2ea3-419e-86fe-dbb7f88d8e08","name":"rural"},{"uuid":"6ad19826-c4a0-4d55-9a47-d79012e356bd","name":"s44a_partially_empty"},{"uuid":"f87f1753-c7e7-4ab2-b57e-bd5611be4f7c","name":"small_business","description":"Includes SBRR, SBBR"},{"uuid":"2adbfa0c-0414-4827-911a-5e0203e43b34","name":"transitional"},{"uuid":"93fec68d-bcfe-42ff-a90e-0c6f663bbb33","name":"other"}]}},{"uuid":"fc7c378c-70db-4364-b8a2-5e050a5eceeb","name":"occupierReliefDate","title":"Relief or Exemption date awarded","description":"Date a relief or exemption is awarded","type":"array"},{"uuid":"af286083-171d-49da-b84b-814ee681e7b4","name":"occupierReliefAmount","title":"Relief or Exemption amount awarded","type":"array"},{"uuid":"80edf660-19c8-4a94-8da3-70b5c412dc4f","name":"occupierSurchargeType","title":"Surcharge or additional rates charge type","description":"NOTE: Type, Date and Amount are arrays and the position in the array must correspond between these three columns. This is for both 'wide' data (where there are multiple columns in the source data for each class of relief) and 'narrow' data (where there is only one set of columns). Narrow data must still be placed in an array (e.g. ['value'], with only one value).","type":"array","constraints":{"enum":[{"uuid":"317f3a54-58e6-4ad4-bc65-31881c2c5294","name":"bid_levy","description":"Business Improvement District, BID"},{"uuid":"0cc6d603-fc6f-4251-a825-ce7f44bf4cc0","name":"crossrail"},{"uuid":"74d1accc-31b1-4bb9-8c65-cff6d12f2383","name":"transitional_surcharge"},{"uuid":"0cb87dae-87f7-4a25-aa7d-0fc6c6c99ff5","name":"city_of_london","description":"If they publish"},{"uuid":"02a1859b-2b2a-4064-84a1-d808d2853926","name":"other"}]}},{"uuid":"92871604-fd9e-4f2f-b6f0-7d694bf6605e","name":"occupierSurchargeDate","title":"Surcharge award date","description":"Date surcharge and additional charges applied","type":"array"},{"uuid":"e3da11ad-d17b-4dda-9fd7-c2a829519ba9","name":"occupierSurchargeAmount","title":"Surcharge Amount Charged","type":"array"}],"version":[{"name":"gchait@whythawk.com","description":"Initial save of SchemaModel.","updated":"2024-01-18T09:45:02.887755"},{"name":"Gavin Chait <gchait@whythawk.com>","description":"Update save of SchemaModel.","updated":"2024-01-18T14:50:55.745764"}]},"actions":[{"uuid":"11d5b3e7-9deb-4d1a-847c-44debd7beb3c","script":"NEW > 'localAuthorityCode' < ['E07000032']"},{"uuid":"2752898f-df71-4822-b78a-d91398ed5734","script":"RENAME > 'localBillingReference' < ['Reference']"},{"uuid":"342919d0-dfca-4b09-a001-d2fa2608cd4b","script":"RENAME > 'occupierPropertyAddress' < ['Property address']"},{"uuid":"1c996fb1-254c-4da8-948f-b856764ad9dc","script":"RENAME > 'occupierAccountStartDate' < ['Liablefrom']"},{"uuid":"4b7f683b-09bc-4566-b6ff-af7779ae9912","script":"CATEGORISE > 'occupierOccupationState'::'Vacant' < 'Emptyfrom'::[True]"},{"uuid":"b8edd740-cd1b-4800-9354-1203439a99e7","script":"CATEGORISE > 'occupierOccupationState'::'Occupied' < 'Emptyfrom'::[False]"},{"uuid":"60d655d0-5a14-4208-989e-06fb45d9e15f","script":"SELECT > 'occupierOccupationDate' < ['Emptyfrom']"},{"uuid":"9de060d5-24f9-4a90-a54a-9d78970aade6","script":"CATEGORISE > 'occupierReliefType'::'empty' < 'Emptyfrom'::[True]"},{"uuid":"403494f5-0faf-4436-a1cb-46f446cac65a","script":"CATEGORISE > 'occupierReliefType'::'mandatory' < 'Relief type'::['Mandatory']"},{"uuid":"9005b97f-bea6-4836-8efb-ede8a601a7b7","script":"CATEGORISE > 'occupierReliefType'::'discretionary' < 'Relief type'::['Discretionary']"},{"uuid":"fd4e34e4-92eb-4b18-a705-3e2ad11ad14b","script":"CATEGORISE > 'occupierReliefType'::'small_business' < 'Relief type'::['SBRR']"},{"uuid":"811029f9-58bb-4db1-bd8b-0026409c082c","script":"CATEGORISE > 'occupierReliefType'::'transitional' < 'Relief type'::['Trans Prem','Transitional']"},{"uuid":"129a9cb1-6a5a-4138-a6a0-63a4ebfe9a54","script":"CATEGORISE > 'occupierReliefType'::'listed' < 'Exemption type'::['Listed Buildings']"},{"uuid":"3a119a02-0236-4d6c-a7c4-f9c9dc7914f6","script":"CATEGORISE > 'occupierReliefType'::'empty' < 'Exemption type'::['CASCs','Charities','Land','Listed Buildings','Telecommunication Masts']"},{"uuid":"67b5d74f-3e3f-4bcc-a978-5e8c37583e75","script":"CATEGORISE > 'occupierReliefType'::'exempt' < 'Exemption type'::['CASCs','Charities','Land','Listed Buildings','Telecommunication Masts']"},{"uuid":"b2ad1f38-71dd-40e9-8c80-5adcd39964f6","script":"COLLATE > 'occupierReliefDate' < ['Emptyfrom',~,~,~,~,'Exemption date','Exemption date','Exemption date']"}]}}