# Auto detect text files and perform LF normalization
* text eol=lf

# Binary files
*.xlsx binary
*.XLSX binary
*.xls binary
*.XLS binary
*.parquet binary
*.PARQUET binary
*.feather binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.pdf binary
*.PDF binary

# Test data keeps its bytes: line endings are among what the readers are tested on
tests/data/** -text
