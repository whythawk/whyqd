,"name":"-849.05"},{"uuid":"6868c417-df5a-40b1-842b-87900940e970","name":"-309.14"},{"uuid":"af911bcf-eb97-4581-a7c3-806058ad5d37","name":"-130.12"},{"uuid":"c2812ff1-e22f-4ff9-9c23-db86d73dc585","name":"-654.69"},{"uuid":"f75a780f-efed-4e21-b1c3-00cec97a4720","name":"-312.01"},{"uuid":"898eff95-f233-4f8f-bd10-c8e9bbd1bd5e","name":"-18.56"},{"uuid":"97cec3d3-6bde-479c-aa29-162a5cb1d2b7","name":"-666.52"},{"uuid":"bec9323f-4137-4e98-9c66-548bc6f1eca9","name":"-632.53"},{"uuid":"5d79c664-3cad-4008-820c-c7c06f64eac5","name":"-192.11"},{"uuid":"a605737e-9055-47aa-818a-cecb612e25a8","name":"-15.66"}]}},{"uuid":"9173ea69-8c38-4270-b474-50e5de1fd642","name":"Date Applied","title":"Date Applied","type":"date"},{"uuid":"0f1ed5c1-0a30-45c8-88b9-9516ab973f10","name":"Value","title":"Value","type":"string"},{"uuid":"bd93b6f7-22a2-4aea-a476-192441fd89b5","name":"Account Start date","title":"Account Start date","type":"string"}],"index":3459,"version":[{"name":"redgine04@gmail.com","description":"Initial save of SchemaModel.","updated":"2025-01-27T10:59:08.538495"},{"name":"redgine04@gmail.com","description":"Update save of SchemaModel.","updated":"2025-02-08T23:54:22.008319"},{"name":"redgine04@gmail.com","description":"Update save of SchemaModel.","updated":"2025-02-08T23:54:23.150435"},{"name":"redgine04@gmail.com","description":"Update save of SchemaModel.","updated":"2025-02-08T23:54:27.011867"},{"name":"redgine04@gmail.com","description":"Update save of SchemaModel.","updated":"2025-02-08T23:54:28.182746"},{"name":"redgine04@gmail.com","description":"Update save of SchemaModel.","updated":"2025-02-08T23:54:52.780778"},{"name":"redgine04@gmail.com","description":"Update save of SchemaModel.","updated":"2025-02-08T23:54:53.913054"},{"name":"redgine04@gmail.com","description":"Update save of SchemaModel.","updated":"2025-02-08T23:54:56.240337"},{"name":"redgine04@gmail.com","description":"Update save of SchemaModel.","updated":"2025-02-08T23:55:03.984965"},{"name":"redgine04@gmail.com","description":"Update save of SchemaModel.","updated":"2025-02-08T23:55:06.352648"},{"name":"redgine04@gmail.com","description":"Update save of SchemaModel.","updated":"2025-02-08T23:55:08.214800"}]},"schemaDestination":{"uuid":"507a0ccf-5735-4b3a-9b9e-2e7842921e4a","name":"england-and-wales-nondomestic-rates-schema","title":"England and Wales non-domestic rates schema","description":"Based on the The Open Data Collaboration group at Open Innovations (Open Innovations, Bradford Council, Calderdale Council, and Leeds Council) which started a project to visualise business rates data. Although each of the three councils publish open data about their business rates, they each have different field titles and don't always include the same fields. This project aimed to standardise the way the data was shared to make it more usable and to get value (within a council and externally) from the datasets.\nhttps://open-innovations.org/projects/business-rates/format.html","fields":[{"uuid":"e1b1d480-8481-4281-98bd-0e59f7fdb949","name":"localAuthorityCode","title":"Local authority code","description":"Unique reference identifier for each local authority. Added from the Task 'name' unique identifier field.","type":"string"},{"uuid":"f42d609b-c8a6-4017-aa9d-d55eb62bd63b","name":"localBillingReference","title":"Billing reference","description":"Local Authority hereditament billing reference used by both VOA & LA to correspond with each other in reference to a specific hereditament.","type":"string","example":"8577090904","constraints":{"required":true,"enum":[]}},{"uuid":"7774382b-7054-4100-8bf1-ff9741a47d5a","name":"occupierAccountHolderName","title":"Occupier account-holder name","description":"Account-holder's names may be split across multiple columns. They are to be joined into one for post-processing.","type":"string","example":"A.M.C (North East) Ltd"},{"uuid":"02347dbe-d491-47cb-bfd4-2a3c28c4c861","name":"occupierRecordDate","title":"Date each row entered the record","type":"date"},{"uuid":"090b1d3d-3be0-4d39-b24b-8c97969eeb8f","name":"occupierAccountStartDate","title":"Start-date for account-holder","description":"Date the Account Holder became responsible for the hereditament. Provide date only if provided in data release from LA. e.g. \"01/01/23\", \"BLANK\" or \"Not Supplied\".","type":"date"},{"uuid":"cb30a0df-ea14-4c67-b76a-1ab358f167bd","name":"occupierPropertyAddress","title":"Address of the rateable property","description":"Address may be split across multiple columns. They are to be joined into one for post-processing with the postcode at the end.","type":"string"},{"uuid":"3ed85652-0831-4cd3-a005-a353b6cc51a1","name":"occupierCorrespondenceAddress","title":"Correspondence address","description":"Account-holders correspondence address may be split across multiple columns. They are to be joined into one for post-processing with the postcode at the end. This may be different from the hereditament address.","type":"string"},{"uuid":"6305545d-7caf-40fb-b421-2e483c3fbd96","name":"occupierOccupationState","title":"Occupation state","description":"Occupational status of hereditament. Only include if provided in LA data release.\nOccupied = \"Occupied\", Void = \"Void\", No Information = \"BLANK\", no empty data provided by LA = \"Not Supplied\"","type":"string","constraints":{"enum":[{"uuid":"83cd608f-ae55-4090-836d-154c2ec256d7","name":"Occupied","description":"Occupied"},{"uuid":"de15f74d-90c3-4f38-8821-37e3178787bd","name":"Vacant","description":"Vacant"}]}},{"uuid":"17c261f9-e837-49d1-abe1-fc63f2a80f86","name":"occupierOccupationDate","title":"Occupation state date","description":"To be used in combination with 'occupierOccupationState'. If only a date is provided (e.g. for only date of void, or date of occupation), then categorise the column as a boolean and use this to specify the state and the date simultaneously.","type":"date"},{"uuid":"e325315f-5ec0-416d-a470-4facfb7bb759","name":"occupierRatesPayable","title":"Actual rates paid","description":"Rates paid, net of reliefs (if available) in pounds. Provide rates paid amount only if provided in data release from LA. e.g. \"£55,000\", \"BLANK\", \"not supplied\".","type":"number"},{"uuid":"1dba84d1-501a-427f-88ad-771e2393516a","name":"occupierReliefType","title":"Relief or Exemption Received","description":"Type of relief or exemption on rates paid received.\n\nNOTE: Type, Date and Amount are arrays and the position in the array must correspond between these three columns. This is for both 'wide' data (where there are multiple columns in the source data for each class of relief) and 'narrow' data (where there is only one set of columns). Narrow data must still be placed in an array (e.g. ['value'], with only one value).","type":"array","constraints":{"enum":[{"uuid":"60fd0916-8f55-4236-8a26-e09cbc9b3c25","name":"charity"},{"uuid":"4f6de275-e6af-4da5-adee-6e5ec60d0488","name":"covid_carf"},{"uuid":"dde9af58-e13c-4ca0-be93-4d46fadb760f","name":"discretionary"},{"uuid":"1b66abb2-3de7-4cfa-8a21-94be7abf8d0a","name":"empty"},{"uuid":"9ec6a8bd-2ee1-4061-bd1d-d454b57c167d","name":"enteprise_zone"},{"uuid":"4320d78d-4d6f-4c31-ba94-0ad2f20bc185","name":"exempt"},{"uuid":"e1895f58-8bc1-4c4c-9f4b-f9f4a507ce5d","name":"hardship"},{"uuid":"3887112a-d266-4e8d-9aa6-1771f2273c9c","name":"insolvency"},{"uuid":"82fe4da5-1e7c-4406-a076-3d8557d64b1b","name":"listed"},{"uuid":"53baf5cb-aff8-47e6-b9ab-f517365f5f7f","name":"mandatory"},{"uuid":"a8a4c3d6-ca77-4776-a754-5848a8415bf3","name":"retail","description":"Has differing definitions at different times"},{"uuid":"f50ade3e-2ea3-419e-86fe-dbb7f88d8e08","name":"rural"},{"uuid":"6ad19826-c4a0-4d55-9a47-d79012e356bd","name":"s44a_partially_empty"},{"uuid":"f87f1753-c7e7-4ab2-b57e-bd5611be4f7c","name":"small_business","description":"Includes SBRR, SBBR"},{"uuid":"2adbfa0c-0414-4827-911a-5e0203e43b34","name":"transitional"},{"uuid":"93fec68d-bcfe-42ff-a90e-0c6f663bbb33","name":"other"}]}},{"uuid":"fc7c378c-70db-4364-b8a2-5e050a5eceeb","name":"occupierReliefDate","title":"Relief or Exemption date awarded","description":"Date a relief or exemption is awarded","type":"array"},{"uuid":"af286083-171d-49da-b84b-814ee681e7b4","name":"occupierReliefAmount","title":"Relief or Exemption amount awarded","type":"array"},{"uuid":"80edf660-19c8-4a94-8da3-70b5c412dc4f","name":"occupierSurchargeType","title":"Surcharge or additional rates charge type","description":"NOTE: Type, Date and Amount are arrays and the position in the array must correspond between these three columns. This is for both 'wide' data (where there are multiple columns in the source data for each class of relief) and 'narrow' data (where there is only one set of columns). Narrow data must still be placed in an array (e.g. ['value'], with only one value).","type":"array","constraints":{"enum":[{"uuid":"317f3a54-58e6-4ad4-bc65-31881c2c5294","name":"bid_levy","description":"Business Improvement District, BID"},{"uuid":"0cc6d603-fc6f-4251-a825-ce7f44bf4cc0","name":"crossrail"},{"uuid":"74d1accc-31b1-4bb9-8c65-cff6d12f2383","name":"transitional_surcharge"},{"uuid":"0cb87dae-87f7-4a25-aa7d-0fc6c6c99ff5","name":"city_of_london","description":"If they publish"},{"uuid":"02a1859b-2b2a-4064-84a1-d808d2853926","name":"other"}]}},{"uuid":"92871604-fd9e-4f2f-b6f0-7d694bf6605e","name":"occupierSurchargeDate","title":"Surcharge award date","description":"Date surcharge and additional charges applied","type":"array"},{"uuid":"e3da11ad-d17b-4dda-9fd7-c2a829519ba9","name":"occupierSurchargeAmount","title":"Surcharge Amount Charged","type":"array"}],"version":[{"name":"gchait@whythawk.com","description":"Initial save of SchemaModel.","updated":"2024-01-18T09:45:02.887755"},{"name":"Gavin Chait <gchait@whythawk.com>","description":"Update save of SchemaModel.","updated":"2024-01-18T14:50:55.745764"}]},"actions":[{"uuid":"aa130315-1d3d-410d-a063-2051c5c0b5ce","script":"NEW > 'localAuthorityCode' < ['E07000044']"},{"uuid":"4f84b61b