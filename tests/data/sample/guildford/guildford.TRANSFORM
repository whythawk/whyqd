sted"},{"uuid":"64e0f0b0-82ea-4174-84c7-723de21ad451","name":"Under the rateable value threshold"},{"uuid":"b4bb8e11-8195-4a51-9571-f5720fe7711f","name":"3 months"}]}},{"uuid":"1a8c6d18-1503-4fb2-9fe3-2dbac116f765","name":"Small Business Rate Relief (Y/N)","title":"Small Business Rate Relief (Y/N)","type":"string","constraints":{"enum":[{"uuid":"909bd79f-2729-4d6a-8b7d-1a5c6374efe7","name":"Y"},{"uuid":"f3d1ba70-13c6-4556-a862-f67cbc570a46","name":"N"}]}},{"uuid":"46145d3a-5eb5-4084-9909-bd874fc04c91","name":"Mandatory Relief (Y/N)","title":"Mandatory Relief (Y/N)","type":"string","constraints":{"enum":[{"uuid":"50066df2-2833-4f13-afe3-72bbc600bbd8","name":"N"},{"uuid":"405369a5-b732-4a51-b3cf-5c6cb983580d","name":"Y"}]}},{"uuid":"4133d552-a2f3-4ae1-89a3-cec11488bf4b","name":"Mandatory Relief %","title":"Mandatory Relief %","type":"string"},{"uuid":"ef9f9725-39bd-4ec2-9054-d058e75def40","name":"Discretionary Relief (Y/N)","title":"Discretionary Relief (Y/N)","type":"string","constraints":{"enum":[{"uuid":"9a493693-0f1c-4bfa-b2b9-47c87b46ecbe","name":"N"},{"uuid":"fd62bf8d-c70c-45aa-9ac3-d7cae5309c6b","name":"Y"}]}},{"uuid":"fd45b7fa-78d6-4df3-947c-54eb9a44778b","name":"Discretionary Relief %","title":"Discretionary Relief %","type":"string"},{"uuid":"fd1a7c1d-983e-46ee-8107-cced7ed83bee","name":"Rural Rate Relief Y/N","title":"Rural Rate Relief Y/N","type":"string","constraints":{"enum":[{"uuid":"96358331-0f89-4881-95fe-004707d0e9cb","name":"N"},{"uuid":"05f753e0-2c6f-4482-b94a-986442d00cc9","name":"Y"}]}},{"uuid":"91ff95d9-64c0-4f2c-9d2c-95bf6304ffbd","name":"Supporting Small Business Relief","title":"Supporting Small Business Relief","type":"string","constraints":{"enum":[{"uuid":"000fd51b-5519-458f-8865-ee1525e7e3e1","name":"N"},{"uuid":"79f56505-7a84-4087-a458-f2dea8f1418d","name":"Y"}]}},{"uuid":"428dde3b-bc90-427c-83f8-b40e558bf1dc","name":"Retail Discount Y/N","title":"Retail Discount Y/N","type":"string","constraints":{"enum":[{"uuid":"b26c780f-82ef-48f8-a418-e2937ddf80bd","name":"N"}]}},{"uuid":"5bb354d6-0ab3-4178-bff1-9c615576eeef","name":"Name","title":"Name","type":"string"},{"uuid":"51473a36-7e51-40e8-afb0-0fd0b6400933","name":"Correspondence Addr 1","title":"Correspondence Addr 1","type":"string"},{"uuid":"075a77cb-f1e0-430a-ab69-70c9ce360b0b","name":"Correspondence Addr 2","title":"Correspondence Addr 2","type":"string"},{"uuid":"43c47c35-5617-4698-936c-cac6e4c7c64f","name":"Correspondence Addr 3","title":"Correspondence Addr 3","type":"string"},{"uuid":"5b84fd97-cc7d-49be-b8d7-8388ac689699","name":"Correspondence Addr 4","title":"Correspondence Addr 4","type":"string"},{"uuid":"01009e98-b76a-4977-8081-a2203d7bd65b","name":"Correspondence Addr 5","title":"Correspondence Addr 5","type":"string"},{"uuid":"33480221-46f9-448d-8f54-f5e4dfa004b9","name":"Correspondence Post Code","title":"Correspondence Post Code","type":"string"},{"uuid":"802d6ae5-b7cc-4645-8117-4c0121953e17","name":"Other Reliefs","title":"Other Reliefs","type":"string","constraints":{"enum":[]}}],"index":4497},"schemaDestination":{"uuid":"507a0ccf-5735-4b3a-9b9e-2e7842921e4a","name":"england-and-wales-nondomestic-rates-schema","title":"England and Wales non-domestic rates schema","description":"Based on the The Open Data Collaboration group at Open Innovations (Open Innovations, Bradford Council, Calderdale Council, and Leeds Council) which started a project to visualise business rates data. Although each of the three councils publish open data about their business rates, they each have different field titles and don't always include the same fields. This project aimed to standardise the way the data was shared to make it more usable and to get value (within a council and externally) from the datasets.\nhttps://open-innovations.org/projects/business-rates/format.html","fields":[{"uuid":"e1b1d480-8481-4281-98bd-0e59f7fdb949","name":"localAuthorityCode","title":"Local authority code","description":"Unique reference identifier for each local authority. Added from the Task 'name' unique identifier field.","type":"string","constraints":{"default":{"uuid":"f62e9a77-c153-4ff9-8eb3-b9963527f942","name":"E07000209"}}},{"uuid":"f42d609b-c8a6-4017-aa9d-d55eb62bd63b","name":"localBillingReference","title":"Billing reference","description":"Local Authority hereditament billing reference used by both VOA & LA to correspond with each other in reference to a specific hereditament.","type":"string","example":"8577090904","constraints":{"required":true,"enum":[]}},{"uuid":"7774382b-7054-4100-8bf1-ff9741a47d5a","name":"occupierAccountHolderName","title":"Occupier account-holder name","description":"Account-holder's names may be split across multiple columns. They are to be joined into one for post-processing.","type":"string","example":"A.M.C (North East) Ltd"},{"uuid":"02347dbe-d491-47cb-bfd4-2a3c28c4c861","name":"occupierRecordDate","title":"Date each row entered the record","type":"date"},{"uuid":"090b1d3d-3be0-4d39-b24b-8c97969eeb8f","name":"occupierAccountStartDate","title":"Start-date for account-holder","description":"Date the Account Holder became responsible for the hereditament. Provide date only if provided in data release from LA. e.g. \"01/01/23\", \"BLANK\" or \"Not Supplied\".","type":"date"},{"uuid":"cb30a0df-ea14-4c67-b76a-1ab358f167bd","name":"occupierPropertyAddress","title":"Address of the rateable property","description":"Address may be split across multiple columns. They are to be joined into one for post-processing with the postcode at the end.","type":"string"},{"uuid":"3ed85652-0831-4cd3-a005-a353b6cc51a1","name":"occupierCorrespondenceAddress","title":"Correspondence address","description":"Account-holders correspondence address may be split across multiple columns. They are to be joined into one for post-processing with the postcode at the end. This may be different from the hereditament address.","type":"string"},{"uuid":"6305545d-7caf-40fb-b421-2e483c3fbd96","name":"occupierOccupationState","title":"Occupation state","description":"Occupational status of hereditament. Only include if provided in LA data release.\nOccupied = \"Occupied\", Void = \"Void\", No Information = \"BLANK\", no empty data provided by LA = \"Not Supplied\"","type":"string","constraints":{"enum":[{"uuid":"83cd608f-ae55-4090-836d-154c2ec256d7","name":"Occupied","description":"Occupied"},{"uuid":"de15f74d-90c3-4f38-8821-37e3178787bd","name":"Vacant","description":"Vacant"}]}},{"uuid":"17c261f9-e837-49d1-abe1-fc63f2a80f86","name":"occupierOccupationDate","title":"Occupation state date","description":"To be used in combination with 'occupierOccupationState'. If only a date is provided (e.g. for only date of void, or date of occupation), then categorise the column as a boolean and use this to specify the state and the date simultaneously.","type":"date"},{"uuid":"e325315f-5ec0-416d-a470-4facfb7bb759","name":"occupierRatesPayable","title":"Actual rates paid","description":"Rates paid, net of reliefs (if available) in pounds. Provide rates paid amount only if provided in data release from LA. e.g. \"£55,000\", \"BLANK\", \"not supplied\".","type":"number"},{"uuid":"1dba84d1-501a-427f-88ad-771e2393516a","name":"occupierReliefType","title":"Relief or Exemption Received","description":"Type of relief or exemption on rates paid received.\n\nNOTE: Type, Date and Amount are arrays and the position in the array must correspond between these three columns. This is for both 'wide' data (where there are multiple columns in the source data for each class of relief) and 'narrow' data (where there is only one set of columns). Narrow data must still be placed in an array (e.g. ['value'], with only one value).","type":"array","constraints":{"enum":[{"uuid":"60fd0916-8f55-4236-8a26-e09cbc9b3c25","name":"charity"},{"uuid":"4f6de275-e6af-4da5-adee-6e5ec60d0488","name":"covid_carf"},{"uuid":"dde9af58-e13c-4ca0-be93-4d46fadb760f","name":"discretionary"},{"uuid":"1b66abb2-3de7-4cfa-8a21-94be7abf8d0a","name":"empty"},{"uuid":"9ec6a8bd-2ee1-4061-bd1d-d454b57c167d","name":"enteprise_zone"},{"uuid":"4320d78d-4d6f-4c31-ba94-0ad2f20bc185","name":"exempt"},{"uuid":"e1895f58-8bc1-4c4c-9f4b-f9f4a507ce5d","name":"hardship"},{"uuid":"3887112a-d266-4e8d-9aa6-1771f2273c9c","name":"insolvency"},{"uuid":"82fe4da5-1e7c-4406-a076-3d8557d64b1b","name":"listed"},{"uuid":"53baf5cb-aff8-47e6-b9ab-f517365f5f7f","name":"mandatory"},{"uuid":"a8a4c3d6-ca77-4776-a754-5848a8415bf3","name":"retail","description":"Has differing definitions at different times"},{"uuid":"f50ade3e-2ea3-419e-86fe-dbb7f88d8e08","name":"rural"},{"uuid":"6ad19826-c4a0-4d55-9a47-d79012e356bd","name":"s44a_partially_empty"},{"uuid":"f87f1753-c7e7-4ab2-b57e-bd5611be4f7c","name":"small_business","description":"Includes SBRR, SBBR"},{"uuid":"2adbfa0c-0414-4827-911a-5e0203e43b34","name":"transitional"},{"uuid":"93fec68d-bcfe-42ff-a90e-0c6f663bbb33","name":"other"},{"uuid":"407bf8b6-dbf9-4707-80df-4713f06b46c1","name":"ssb_one_year","description":"Supporting Small Business 1 Year"},{"uuid":"57e578f6-5f02-457b-b83a-cab6f6bfce3d","name":"ssb_three_year","description":"Supporting Small Business 3 Year"},{"uuid":"d0214f96-836f-4aad-b8da-a9f860beb03e","name":"ssb_unspecified","description":"Supporting Small Business"},{"uuid":"aac2de06-bcc9-44bc-86d0-d753fefa1b76","name":"improvement","description":"Improvement"},{"uuid":"ccefe7d1-9c1e-4cd1-b262-648dc7ef7d45","name":"heat_network","description":"Heat Network"},{"uuid":"c641779a-d8c8-4fda-970e-966e931198ae","name":"public_lavatories","description":"Public Lavatories"},{"uuid":"d7b8ab22-286f-4781-8be9-d461199fab7a","name":"freeport","description":"Freeport"},{"uuid":"47c4b03e-9d6a-41e3-a7ab-5f40e17121aa","name":"film_studio","description":"Film Studio"},{"uuid":"26268f7b-8ecb-4f20-b8d6-5d0db06c932b","name":"pubs_live_music","description":"Pubs and Live Music Venues"},{"uuid":"c8094a9f-33e9-4b3f-bc9b-2087296798b2","name":"ev_charging","description":"EV Charging Point"},{"uuid":"729c0681-1746-4539-a96c-2792bdfdde04","name":"local_newspaper","description":"Local Newspaper"}]}},{"uuid":"af286083-171d-49da-b84b-814ee681e7b4","name":"occupierReliefAmount","title":"Relief or Exemption amount awarded","type":"array"},{"uuid":"fc7c378c-70db-4364-b8a2-5e050a5eceeb","name":"occupierReliefDate","title":"Relief or Exemption date awarded","description":"Date a relief or exemption is awarded","type":"array"},{"uuid":"80edf660-19c8-4a94-8da3-70b5c412dc4f","name":"occupierSurchargeType","title":"Surcharge or additional rates charge type","description":"NOTE: Type, Date and Amount are arrays and the position in the array must correspond between these three columns. This is for both 'wide' data (where there are multiple columns in the source data for each class of relief) and 'narrow' data (where there is only one set of columns). Narrow data must still be placed in an array (e.g. ['value'], with only one value).","type":"array","constraints":{"enum":[{"uuid":"317f3a54-58e6-4ad4-bc65-31881c2c5294","name":"bid_levy","description":"Business Improvement District, BID"},{"uuid":"0cc6d603-fc6f-4251-a825-ce7f44bf4cc0","name":"crossrail"},{"uuid":"74d1accc-31b1-4bb9-8c65-cff6d12f2383","name":"transitional_surcharge"},{"uuid":"0cb87dae-87f7-4a25-aa7d-0fc6c6c99ff5","name":"city_of_london","description":"If they publish"},{"uuid":"02a1859b-2b2a-4064-84a1-d808d2853926","name":"other"}]}},{"uuid":"e3da11ad-d17b-4dda-9fd7-c2a829519ba9","name":"occupierSurchargeAmount","title":"Surcharge Amount Charged","type":"array"},{"uuid":"92871604-fd9e-4f2f-b6f0-7d694bf6605e","name":"occupierSurchargeDate","title":"Surcharge award date","description":"Date surcharge and additional charges applied","type":"array"}],"version":[{"name":"gchait@whythawk.com","description":"Initial save of SchemaModel.","updated":"2024-01-18T09:45:02.887755"},{"name":"Gavin Chait <gchait@whythawk.com>","description":"Update save of SchemaModel.","updated":"2024-01-18T14:50:55.745764"},{"name":"Gavin Chait <gchait@whyt